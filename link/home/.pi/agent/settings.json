{
  "lastChangelogVersion": "1.5.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "low",
  "theme": "catppuccin-mocha",
  "packages": [
    "npm:@marckrenn/pi-sub-bar",
    "npm:@ifi/pi-plan",
    {
      "source": "npm:pi-worktree",
      "extensions": [
        "+extensions/worktree.ts"
      ]
    },
    "git:https://github.com/hasit/pi-community-themes",
    "npm:pi-hashline-readmap",
    {
      "source": "git:github.com/MasuRii/pi-tool-display",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:@tmustier/pi-usage-extension",
    "npm:pi-web-access",
    {
      "source": "npm:pi-cbm",
      "extensions": [
        "+src/index.ts"
      ]
    },
    "npm:avtc-pi-notification",
    {
      "source": "npm:@hk_net/remote-pi",
      "extensions": [
        "-dist/extension.js"
      ],
      "skills": [
        "-skills/agent-network/SKILL.md"
      ]
    },
    "npm:pi-context-view"
  ],
  "subagents": {
    "defaultModel": "gpt-6.1-sol",
    "disableBuiltins": true,
    "agentOverrides": {
      "worker": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "disabled": false,
        "thinking": "high",
        "defaultContext": "fresh",
        "systemPromptMode": "replace",
        "inheritProjectContext": false
      },
      "planner": {
        "disabled": true
      },
      "oracle": {
        "disabled": true
      },
      "researcher": {
        "disabled": true
      },
      "context-builder": {
        "disabled": true
      },
      "delegate": {
        "disabled": true
      }
    }
  },
  "avtc-pi-notifications": {
    "bell": true,
    "bellDelay": "30s",
    "telegram": {
      "enabled": true,
      "chatId": "5732158113",
      "delay": "45s",
      "includePrompt": true,
      "includeToolErrors": true,
      "includeLeaf": false,
      "includeStarted": true
    }
  },
  "hideThinkingBlock": false,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@marckrenn/pi-sub-bar\",\"scope\":\"user\"}": "1.5.0",
    "{\"source\":\"npm:pi-hashline-readmap\",\"scope\":\"user\"}": "0.19.0",
    "{\"source\":\"git:github.com/MasuRii/pi-tool-display\",\"scope\":\"user\"}": "0.5.0",
    "{\"source\":\"npm:@tmustier/pi-usage-extension\",\"scope\":\"user\"}": "0.10.2",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"npm:pi-context-view\",\"scope\":\"user\"}": "0.8.3"
  }
}