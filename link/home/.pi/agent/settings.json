{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "low",
  "theme": "catppuccin-mocha",
  "packages": [
    "git:github.com/dbachelder/pi-btw",
    "npm:@marckrenn/pi-sub-bar",
    "npm:@ifi/pi-plan",
    {
      "source": "npm:pi-worktree",
      "extensions": [
        "+extensions/worktree.ts"
      ]
    },
    "git:https://github.com/hasit/pi-community-themes",
    "npm:pi-hashline-readmap",
    {
      "source": "git:github.com/MasuRii/pi-tool-display",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:@tmustier/pi-usage-extension",
    "npm:pi-web-access",
    {
      "source": "npm:pi-cbm",
      "extensions": [
        "+src/index.ts"
      ]
    },
    "npm:avtc-pi-notification"
  ],
  "subagents": {
    "defaultModel": "gpt-5.6-sol",
    "disableBuiltins": true,
    "agentOverrides": {
      "worker": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "model": "opencode-go/glm-5.3-flash",
        "disabled": false,
        "thinking": "medium",
        "defaultContext": "fresh",
        "systemPromptMode": "replace",
        "inheritProjectContext": false
      },
      "planner": {
        "disabled": true
      },
      "oracle": {
        "disabled": true
      },
      "researcher": {
        "disabled": true
      },
      "context-builder": {
        "disabled": true
      },
      "delegate": {
        "disabled": true
      }
    }
  },
  "avtc-pi-notifications": {
    "bell": true,
    "bellDelay": "30s",
    "telegram": {
      "enabled": true,
      "chatId": "5732158113",
      "delay": "45s",
      "includePrompt": true,
      "includeToolErrors": true,
      "includeLeaf": false,
      "includeStarted": true
    }
  },
  "hideThinkingBlock": false
}
